# Copy to backend/.env. Keep real secrets out of Git and out of frontend/Vite variables.
APP_NAME=AegisFlow API
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
# Set to the exact model ID available to your Google AI Studio/API account.
GEMINI_MODEL=gemini-3.6-flash
# Use the test-mode signing secret from Stripe CLI or a test-mode webhook endpoint.
# Stripe test webhook signing secrets start with whsec_; leave empty to disable real webhooks.
STRIPE_WEBHOOK_SECRET=
# Salesforce read-only client-credentials access. Keep these secrets backend-only.
# Configure a Salesforce Connected App with client-credentials flow and a least-privilege
# integration user that has API access and read permission for the Lead fields used.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v62.0
DATABASE_PATH=./data/aegisflow.sqlite3
MAX_REQUEST_BYTES=1048576
