# Copy values to backend/.env. Never commit actual API keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional test-mode webhook signing secret only; never use a live-mode secret.
STRIPE_WEBHOOK_SECRET=
# Salesforce read-only client-credentials access. Keep these secrets backend-only.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v62.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
